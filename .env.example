# Copie para .env e preencha. O .env fica fora do Git.
# Na Railway não existe .env: cole estas variáveis em Variables, no painel.

# Supabase → Project Settings → Database → Connection string → URI.
# Use a string do POOLER (Session pooler / Transaction pooler), não a "Direct
# connection": a conexão direta só atende por IPv6 e a Railway não alcança.
# Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Só se o front estiver hospedado à parte (GitHub Pages, Netlify…).
# Endereços separados por vírgula, sem barra no fim. Deixe vazio se o backend
# serve a tela.
ORIGENS_PERMITIDAS=

# Porta local. A Railway define PORT sozinha e ignora isto.
PORTA=3000

# 1 desliga a leitura do site da Nescafé ao subir (útil em teste).
SEM_SINCRONIA=0

# --- Recuperação de senha por e-mail (opcional) ---
# Sem estas, o "esqueci minha senha" cai no código de recuperação e no pedido
# ao espremedor. O sistema inteiro funciona sem e-mail.
#
# Brevo → SMTP & API → API Keys. O plano gratuito manda 300 por dia.
BREVO_API_KEY=
# O endereço remetente, JÁ VERIFICADO em Brevo → Senders (pode ser seu Gmail).
# Sem verificar, o Brevo recusa com HTTP 400.
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Espremedor de Laranja

# Para onde o link do e-mail aponta — o endereço público da TELA, sem barra no
# fim. Se o front está no GitHub Pages, é o endereço de lá, não o da Railway.
# Vazio: cai no primeiro de ORIGENS_PERMITIDAS.
ENDERECO_DO_SITE=
